<?xml version="1.0" encoding="utf-8"?>
<!-- A screen opening over the one below: a short rise with a fade, not a slide from the bottom edge. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="200"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate
        android:fromYDelta="6%"
        android:toYDelta="0%" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
