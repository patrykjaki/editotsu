<?xml version="1.0" encoding="utf-8"?>
<!-- Downloads screen: M3 top bar, storage/activity summary card, Anime/Manga/Novel segmented filter,
     active queue + downloaded library list, and centered empty state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/downloadQueueContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".settings.DownloadQueueActivity">

    <!-- 64dp M3 Small Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadQueueBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_round_arrow_back_ios_new_24"
            app:iconTint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/downloadQueueTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/download_queue"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            tools:ignore="UnusedAttribute" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadQueueClear"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/clear_queue"
            android:tooltipText="@string/clear_queue"
            android:visibility="gone"
            app:icon="@drawable/ic_round_delete_24"
            app:iconTint="?attr/colorError"
            tools:ignore="UnusedAttribute"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadQueueOptions"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/downloads_options"
            android:tooltipText="@string/downloads_options"
            app:icon="@drawable/ic_round_settings_24"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:ignore="UnusedAttribute" />
    </LinearLayout>

    <!-- Storage & Activity Summary Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/downloadsSummaryCard"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_round_sd_card_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/downloadsStorageLine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    tools:text="Downloads 0 B · 7.9 GB free" />
            </LinearLayout>

            <ani.dantotsu.settings.SegmentedStorageBarView
                android:id="@+id/downloadsStorageBar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/downloadsBreakdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="3 anime · 2 manga" />

                <TextView
                    android:id="@+id/downloadsActiveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="1 downloading · 2 queued"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- M3 Segmented Category Filter (Anime / Manga / Novel) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/downloadsTypeToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadsTypeAnime"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semi_bold"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="@string/anime"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadsTypeManga"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semi_bold"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="@string/manga"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadsTypeNovel"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semi_bold"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="@string/extensions_type_novel"
            android:textAllCaps="false"
            android:textSize="14sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Content Area: Active Queue + Downloaded List, or Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ani.dantotsu.FadingEdgeRecyclerView
            android:id="@+id/downloadQueueRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            android:requiresFadingEdge="vertical"
            tools:listitem="@layout/item_download_queue" />

        <LinearLayout
            android:id="@+id/downloadQueueEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingBottom="48dp"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/downloads_empty_icon_bg">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_download_24"
                    app:tint="?attr/colorOnSecondaryContainer" />
            </FrameLayout>

            <TextView
                android:id="@+id/downloadQueueEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:gravity="center"
                android:text="@string/downloads_empty_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/downloadQueueEmptyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:maxWidth="300dp"
                android:text="@string/downloads_empty_anime_body"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
