<?xml version="1.0" encoding="utf-8"?>
<!-- One theme. Background is set in code (grouped corners). Tapping the row plays it; the heart saves it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/themeMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/themeTag"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            tools:text="ED 4" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/themeSong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semi_bold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                tools:text="Korogaru Iwa, Kimi ni Asa ga Furu" />

            <TextView
                android:id="@+id/themeMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="Kessoku Band · Ep 12 · Spoiler" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/themeFavourite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_round_favorite_border_24"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:contentDescription="Add to favourites" />

        <ImageView
            android:id="@+id/themePlay"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/theme_play_circle"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_round_play_arrow_24"
            app:tint="?attr/colorOnPrimary" />
    </LinearLayout>

    <!-- Only for themes with several versions; opens the list below. -->
    <TextView
        android:id="@+id/themeVersionsToggle"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="-8dp"
        android:layout_marginBottom="4dp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="0dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:visibility="gone"
        app:drawableEndCompat="@drawable/ic_round_arrow_drop_down_24"
        app:drawableTint="?attr/colorPrimary"
        tools:text="v2 of 3"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/themeVersions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
