<?xml version="1.0" encoding="utf-8"?>
<!-- Unified Search Filters bottom sheet: primary handle, title + reset icon, a chip row for Sort / Genres & tags / Adult, a divider, then chip sections (all filled in code). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchFiltersRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp"
    android:clipToPadding="false">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/searchFiltersHandle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/shape_choice_handle"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/searchFiltersTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/search_filters"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            tools:ignore="UnusedAttribute" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/searchFiltersReset"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/reset_filters"
            android:tooltipText="@string/reset_filters"
            android:visibility="gone"
            app:icon="@drawable/ic_round_refresh_24"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:ignore="UnusedAttribute"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/searchFiltersTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="16dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="0dp" />

    <View
        android:id="@+id/searchFiltersDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="?attr/colorOutlineVariant"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/searchFiltersSections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
