<?xml version="1.0" encoding="utf-8"?>
<!-- MAX MERGE M7A: manual torrent/magnet entry sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/manualTorrentContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:backgroundTintMode="src_atop"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/manualTorrentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/manual_torrent_title"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/manualTorrentPendingRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/manualTorrentPendingText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/manual_torrent_received" />

        <Button
            android:id="@+id/manualTorrentUsePending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/manual_torrent_use" />
    </LinearLayout>

    <!-- M7A G2 sheet r2 (upstream DirectTorrentBottomSheet style): one input
         row, so the file list keeps most of the sheet in landscape. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/manualTorrentMagnetInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/manual_torrent_magnet_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/manualTorrentPaste"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/manual_torrent_paste"
            android:src="@drawable/ic_round_content_paste_24"
            app:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/manualTorrentPickFile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/manual_torrent_pick_file"
            android:src="@drawable/ic_round_folder_24"
            app:tint="?attr/colorPrimary" />

        <Button
            android:id="@+id/manualTorrentAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="@string/manual_torrent_add" />
    </LinearLayout>

    <TextView
        android:id="@+id/manualTorrentStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="center"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/manualTorrentProgress"
        style="?android:attr/progressBarStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- M7A G2 runtime P0: MaxHeightRecyclerView, because
         android:maxHeight is silently ignored by RecyclerView and the
         unbounded list pushed the action row off-screen. Same 320dp cap
         the layout always intended.
         0dp + weight: when the sheet is shorter than its content
         (landscape, large font) the list shrinks and scrolls instead of
         overflowing the screen; when it fits, the list keeps its natural
         (capped) height. -->
    <TextView
        android:id="@+id/manualTorrentFilesHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.7"
        android:text="@string/manual_torrent_tap_to_play"
        android:textSize="12sp"
        android:visibility="gone" />

    <ani.dantotsu.torrent.MaxHeightRecyclerView
        android:id="@+id/manualTorrentFileList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- No action row (r2): tap a file to play it, the row's download icon
         downloads it; back / swipe-down cancels. -->

</LinearLayout>
