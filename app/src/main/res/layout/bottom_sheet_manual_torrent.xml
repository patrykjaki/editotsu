<?xml version="1.0" encoding="utf-8"?>
<!-- MAX MERGE M7A: manual torrent/magnet entry sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/manualTorrentContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:backgroundTintMode="src_atop"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/manualTorrentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/manual_torrent_title"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/manualTorrentPendingRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/manualTorrentPendingText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/manual_torrent_received" />

        <Button
            android:id="@+id/manualTorrentUsePending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/manual_torrent_use" />
    </LinearLayout>

    <EditText
        android:id="@+id/manualTorrentMagnetInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/manual_torrent_magnet_hint"
        android:inputType="textUri"
        android:maxLines="3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/manualTorrentPaste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/manual_torrent_paste" />

        <Button
            android:id="@+id/manualTorrentAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/manual_torrent_add" />
    </LinearLayout>

    <Button
        android:id="@+id/manualTorrentPickFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/manual_torrent_pick_file" />

    <TextView
        android:id="@+id/manualTorrentStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="center"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/manualTorrentProgress"
        style="?android:attr/progressBarStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- M7A G2 runtime P0: MaxHeightRecyclerView, because
         android:maxHeight is silently ignored by RecyclerView and the
         unbounded list pushed the action row off-screen. Same 320dp cap
         the layout always intended. -->
    <ani.dantotsu.torrent.MaxHeightRecyclerView
        android:id="@+id/manualTorrentFileList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/manualTorrentActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/manualTorrentPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/manual_torrent_play" />

        <Button
            android:id="@+id/manualTorrentDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/manual_torrent_download" />
    </LinearLayout>

    <Button
        android:id="@+id/manualTorrentCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@android:string/cancel" />

</LinearLayout>
