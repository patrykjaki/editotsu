<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/commentsCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/commentUserAvatarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/transparent"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/transparent"
        app:strokeWidth="0dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/commentUserAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:srcCompat="@drawable/ic_round_add_circle_24"
            tools:ignore="ContentDescription,ImageContrastCheck"
            tools:tint="@color/bg_black_50" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/commentUserDetailsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/commentUserAvatarContainer"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/commentUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semi_bold"
            android:singleLine="true"
            android:text="Username"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/adminBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_crown"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/modBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_shield"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/commentUserLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_comment_tag"
            android:fontFamily="@font/poppins_semi_bold"
            android:includeFontPadding="false"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Lv 1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="10sp"
            tools:ignore="HardcodedText,SmallSp" />

        <TextView
            android:id="@+id/commentUserTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/poppins"
            android:singleLine="true"
            android:text="Time"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/commentUserTagLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_comment_tag"
            android:gravity="center_vertical"
            android:minHeight="24dp"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_label_24"
                app:tint="?attr/colorPrimary"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/commentUserTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="11"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                tools:ignore="HardcodedText,SmallSp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/commentText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/poppins"
        android:lineSpacingExtra="2sp"
        android:maxLines="8"
        android:text="@string/slogan"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/commentUserDetailsLayout"
        app:layout_constraintTop_toBottomOf="@id/commentUserDetailsLayout" />

    <LinearLayout
        android:id="@+id/linearLayout6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="-10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/commentUserDetailsLayout"
        app:layout_constraintTop_toBottomOf="@id/commentText">

        <ImageView
            android:id="@+id/commentUpVote"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/comment_upvote"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_round_upvote_inactive_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/commentTotalVotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center"
            android:minWidth="16dp"
            android:text="100"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/commentDownVote"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/comment_downvote"
            android:padding="10dp"
            android:rotation="180"
            app:srcCompat="@drawable/ic_round_upvote_inactive_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/commentReply"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reply"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_round_reply_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/commentEdit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_round_edit_note_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/commentInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/comment_more"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_round_dots_vertical_24"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <View
        android:id="@+id/commentRepliesDivider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/commentTotalReplies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/poppins_semi_bold"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:paddingEnd="12dp"
        android:text="View replies"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/commentUserDetailsLayout"
        app:layout_constraintTop_toBottomOf="@id/linearLayout6"
        tools:ignore="HardcodedText,RtlSymmetry" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/commentRepliesList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/commentUserDetailsLayout"
        app:layout_constraintTop_toBottomOf="@id/commentTotalReplies"
        tools:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
