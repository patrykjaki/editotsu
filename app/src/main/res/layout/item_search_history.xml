<?xml version="1.0" encoding="utf-8"?>
<!-- One recent search row inside the grouped recents card (SettingsCards sets fill, corners and ripple). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_round_history_24"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/searchHistoryTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_family"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        tools:text="Made in Abyss" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/closeTextView"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/clear"
        android:tooltipText="@string/clear"
        app:icon="@drawable/ic_round_close_24"
        app:iconTint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
