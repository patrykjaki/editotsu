<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- Top Drag Handle -->
        <androidx.cardview.widget.CardView
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/torrentBufferingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center"
            android:text="@string/torrent_buffering_title"
            android:textSize="20sp" />

        <!-- Episode / Media Subtitle -->
        <TextView
            android:id="@+id/torrentBufferingSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            tools:text="Episode 1 • 1080p Dual Audio" />

        <!-- Progress Bar Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/torrentBufferingProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="?attr/colorSurface"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <!-- Status description -->
                <TextView
                    android:id="@+id/torrentBufferingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:gravity="center"
                    android:text="@string/torrent_buffering_connecting"
                    android:textSize="14sp" />

                <!-- Live Metrics Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Download Speed -->
                    <TextView
                        android:id="@+id/torrentBufferingSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins"
                        android:gravity="center"
                        android:text="⬇ 0 KB/s"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:background="?android:attr/textColorSecondary"
                        android:alpha="0.3" />

                    <!-- Peers -->
                    <TextView
                        android:id="@+id/torrentBufferingPeers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins"
                        android:gravity="center"
                        android:text="👥 0 peers"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:background="?android:attr/textColorSecondary"
                        android:alpha="0.3" />

                    <!-- Pieces -->
                    <TextView
                        android:id="@+id/torrentBufferingPieces"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins"
                        android:gravity="center"
                        android:text="Pieces: 0/4"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/torrentBufferingCancelButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:text="@string/torrent_buffering_cancel"
            android:textSize="15sp"
            app:cornerRadius="14dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
