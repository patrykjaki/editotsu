<?xml version="1.0" encoding="utf-8"?>
<!-- One settings row. Every kind (switch, choice, slider, stepper, segments, action) uses
     this layout, so size and spacing are the same on every screen. The card background,
     ripple and side margins are set in code (SettingsCards), from the theme's colours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/rowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:tint="?attr/colorPrimary"
            tools:ignore="ContentDescription"
            tools:srcCompat="@drawable/ic_round_settings_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                tools:text="Title" />

            <TextView
                android:id="@+id/rowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                tools:text="Summary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/rowMinus"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/decrease"
            android:src="@drawable/ic_minus"
            android:visibility="gone"
            app:tint="?attr/colorOnBackground" />

        <TextView
            android:id="@+id/rowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center"
            android:maxLines="2"
            android:maxWidth="104dp"
            android:minWidth="36dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="1.25x" />

        <ImageButton
            android:id="@+id/rowPlus"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/increase"
            android:src="@drawable/ic_add"
            android:visibility="gone"
            app:tint="?attr/colorOnBackground" />

        <LinearLayout
            android:id="@+id/rowTrailing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/rowSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:thumbTint="@color/button_switch_track" />

        <ImageView
            android:id="@+id/rowChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:rotation="180"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
            app:tint="?attr/colorPrimary"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/rowSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:visibility="gone"
        app:labelBehavior="gone"
        app:thumbColor="?attr/colorSecondary"
        app:tickColorInactive="?attr/colorSecondary"
        app:trackColorActive="?attr/colorSecondary" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/rowSegments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:selectionRequired="true"
        app:singleSelection="true" />

    <LinearLayout
        android:id="@+id/rowExtra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
