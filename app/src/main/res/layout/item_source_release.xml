<?xml version="1.0" encoding="utf-8"?>
<!--
    Source Picker v3 Final: one torrent/release card.
    Line 1: release group + seeders. Line 2: clean title. Optional
    Best-match line. Line 3: one fixed tag line ("+N" when it overflows),
    size, and actions. The details panel opens under it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/sourceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/sourceHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:singleLine="true"
                    android:textSize="18sp"
                    tools:text="EMBER" />

                <TextView
                    android:id="@+id/sourceSeeders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/poppins_bold"
                    android:singleLine="true"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="14sp"
                    tools:text="313 seeds" />
            </LinearLayout>

            <TextView
                android:id="@+id/sourceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="2"
                android:paddingEnd="12dp"
                android:textSize="14sp"
                tools:text="Frieren: Beyond Journey's End (2023) S01" />

            <TextView
                android:id="@+id/sourceWhy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:paddingEnd="12dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Best match · you picked this last time"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ani.dantotsu.media.anime.selector.TagLineLayout
                    android:id="@+id/sourceTags"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/sourceSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:alpha="0.75"
                    android:fontFamily="@font/poppins"
                    android:singleLine="true"
                    android:textSize="13sp"
                    tools:text="648 MB" />

                <ImageButton
                    android:id="@+id/sourceSub"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/download_subtitle"
                    android:src="@drawable/ic_round_subtitles_24"
                    android:visibility="gone"
                    app:tint="?attr/colorOnBackground" />

                <ImageButton
                    android:id="@+id/sourceDownload"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/download"
                    android:src="@drawable/ic_download_24"
                    android:visibility="gone"
                    app:tint="?attr/colorOnBackground" />

                <ImageButton
                    android:id="@+id/sourceExpand"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/source_details"
                    android:src="@drawable/ic_round_info_24"
                    app:tint="?attr/colorOnBackground" />
            </LinearLayout>

            <TextView
                android:id="@+id/sourceDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:fontFamily="@font/poppins"
                android:lineSpacingExtra="2dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Release group: EMBER\nTracker: NyaaSi"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
