<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Player > Subtitles: how subtitles look with the current colours, font and
     size. First row of the subtitles section card (SettingsCards). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/subPreviewFrame"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:background="@drawable/bg_sub_preview"
        android:importantForAccessibility="no">

        <FrameLayout
            android:id="@+id/subPreviewWindow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/subPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingHorizontal="4dp"
                android:text="@string/sub_text_example" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
