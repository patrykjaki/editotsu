<?xml version="1.0" encoding="utf-8"?>
<!-- A favourite theme: tag, song, show · artist, saved state; heart, download, play. Grouped corners set in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/favRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginBottom="2dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/favTag"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/poppins_bold"
        android:includeFontPadding="false"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        tools:text="ED 4" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/favSong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semi_bold"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="Korogaru Iwa, Kimi ni Asa ga Furu" />

        <TextView
            android:id="@+id/favMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="Bocchi the Rock! · Kessoku Band" />

        <TextView
            android:id="@+id/favSaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="4dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_circle_check"
            app:drawableTint="?attr/colorPrimary"
            tools:text="Audio saved"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/favHeart"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/theme_favourite_remove"
        android:src="@drawable/ic_round_favorite_24"
        android:tooltipText="@string/theme_favourite_remove"
        app:tint="?attr/colorPrimary" />

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <ImageButton
            android:id="@+id/favDownload"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_download_24"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:contentDescription="Download" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/favProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:indicatorSize="36dp"
            app:trackThickness="3dp" />
    </FrameLayout>

    <ImageView
        android:id="@+id/favPlay"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/theme_play_circle"
        android:importantForAccessibility="no"
        android:padding="7dp"
        android:src="@drawable/ic_round_play_arrow_24"
        app:tint="?attr/colorOnPrimary" />
</LinearLayout>
