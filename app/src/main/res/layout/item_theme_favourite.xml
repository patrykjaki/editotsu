<?xml version="1.0" encoding="utf-8"?>
<!-- M3 3-line favourite theme row, matching item_anime_theme_row: overline (play cue + OP/ED tag + saved status), headline song, single-line supporting meta, and two 48dp trailing icon actions (heart, download). Grouped corners set in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/favRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="2dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="4dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Cue that tapping the row plays it; the row itself takes the tap. -->
            <ImageView
                android:id="@+id/favPlay"
                android:layout_width="10dp"
                android:layout_height="12dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_theme_play_cue"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/favTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                tools:text="ED 1 v2" />

            <TextView
                android:id="@+id/favSaved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semi_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Audio saved"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/favSong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semi_bold"
            android:hyphenationFrequency="normal"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            tools:text="Korogaru Iwa, Kimi ni Asa ga Furu" />

        <TextView
            android:id="@+id/favMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            tools:text="Bocchi the Rock! · Kessoku Band" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/favHeart"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/theme_favourite_remove"
        android:src="@drawable/ic_round_favorite_24"
        android:tooltipText="@string/theme_favourite_remove"
        app:tint="?attr/colorPrimary" />

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <ImageButton
            android:id="@+id/favDownload"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_download_24"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:contentDescription="Download" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/favProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:indicatorSize="36dp"
            app:trackThickness="3dp" />
    </FrameLayout>
</LinearLayout>
