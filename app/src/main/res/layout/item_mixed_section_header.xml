<?xml version="1.0" encoding="utf-8"?>
<!-- Mixed "All" search section header: section title + 48dp "See all" arrow switching to that type. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mixedSectionHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/mixedSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_semi_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        tools:ignore="UnusedAttribute"
        tools:text="Anime" />

    <ImageView
        android:id="@+id/mixedSectionMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_round_arrow_forward_ios_24"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
