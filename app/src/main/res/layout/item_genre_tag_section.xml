<?xml version="1.0" encoding="utf-8"?>
<!-- One section in GenreTagSheet: optional "Tags" overline, section/category header (collapsible for tag categories), and wrapped M3 ChipGroup. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/genreTagTagsSubheader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:fontFamily="@font/poppins_semi_bold"
        android:includeFontPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:text="@string/tags"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:visibility="gone"
        tools:ignore="UnusedAttribute"
        tools:visibility="visible" />

    <View
        android:id="@+id/genreTagSectionDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="?attr/colorOutlineVariant"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/genreTagSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/genreTagSectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semi_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            tools:ignore="UnusedAttribute"
            tools:text="Theme / Fantasy" />

        <TextView
            android:id="@+id/genreTagSectionCount"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_genre_tag_count_pill"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="24dp"
            android:paddingHorizontal="8dp"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="2"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/genreTagSectionChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_round_expand_more_24"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/genreTagChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="0dp" />
</LinearLayout>
