<?xml version="1.0" encoding="utf-8"?>
<!-- One action on the Themes screen: round icon button with a short label under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageButton
        android:id="@+id/actionIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/theme_play_circle"
        android:importantForAccessibility="no"
        android:padding="15dp"
        android:scaleType="fitCenter"
        app:tint="?attr/colorOnPrimary"
        tools:src="@drawable/ic_shuffle_24" />

    <TextView
        android:id="@+id/actionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_semi_bold"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        tools:text="Shuffle completed shows" />
</LinearLayout>
