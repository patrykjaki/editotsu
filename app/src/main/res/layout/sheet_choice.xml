<?xml version="1.0" encoding="utf-8"?>
<!-- The one "pick from a list" sheet (ChoiceSheet). Options are drawn as a grouped card, the
     same shape and fill as settings rows; the chosen option takes the secondary container. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:id="@+id/choiceHandle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/shape_choice_handle"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/choiceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:fontFamily="@font/poppins_bold"
        android:paddingHorizontal="32dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        tools:ignore="UnusedAttribute"
        tools:text="Upscaler" />

    <LinearLayout
        android:id="@+id/choiceNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/choiceNoteIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_round_info_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/choiceNoteText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            tools:text="Larger models need Vulkan." />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/choiceList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:scrollbars="vertical"
        tools:listitem="@layout/item_choice_option" />

    <LinearLayout
        android:id="@+id/choiceActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/choiceReset"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reset"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_round_refresh_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/choiceConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:minHeight="48dp"
            app:icon="@drawable/ic_check"
            tools:text="Import" />
    </LinearLayout>
</LinearLayout>
