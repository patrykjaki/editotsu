<?xml version="1.0" encoding="utf-8"?>
<!-- Header of the Themes screen: M3 top bar with audio-only toggle, OP/ED filter, four actions, and Favourites section heading. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 64dp M3 Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/themesBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/themes_back"
            app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/anime_themes_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/themesAudioOnly"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/theme_audio_only"
            android:src="@drawable/ic_round_audiotrack_24"
            android:tooltipText="@string/theme_audio_only"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Full-width 16dp-gutter OP / ED segmented filter -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/themesKinds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kindBoth"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="@string/themes_kind_both" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kindOpenings"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="@string/themes_kind_openings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kindEndings"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="@string/themes_kind_endings" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Actions row: 1 primary hero (Shuffle completed) + 3 tonal secondary actions (Favourites) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include
            android:id="@+id/actionShuffleCompleted"
            layout="@layout/item_themes_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/actionPlayFavourites"
            layout="@layout/item_themes_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/actionShuffleFavourites"
            layout="@layout/item_themes_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/actionDownloadAll"
            layout="@layout/item_themes_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/themesStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Looking up themes"
        tools:visibility="visible" />

    <!-- Favourites section header + trailing saved size -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/themesFavouritesLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:text="@string/themes_favourites"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/themesSaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Saved: 84 MB"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/themesEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:fontFamily="@font/poppins"
        android:text="@string/themes_no_favourites"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
