<?xml version="1.0" encoding="utf-8"?>
<!-- "Openings" or "Endings": label with play-all, rows, and a show-all toggle past four rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sectionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:fontFamily="@font/poppins_semi_bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="Openings" />

        <ImageButton
            android:id="@+id/sectionPlayAll"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_round_playlist_play_24"
            app:tint="?attr/colorPrimary"
            tools:contentDescription="Play all openings" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sectionRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/sectionToggle"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="2dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:visibility="gone"
        app:drawableEndCompat="@drawable/ic_round_arrow_drop_down_24"
        app:drawableTint="?attr/colorPrimary"
        tools:text="Show all 5 openings"
        tools:visibility="visible" />
</LinearLayout>
