<?xml version="1.0" encoding="utf-8"?>
<!-- "Openings" or "Endings": section label with play-all icon, grouped rows on the 16dp gutter, and show-all toggle past four rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/sectionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:fontFamily="@font/poppins_semi_bold"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            tools:text="Openings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sectionPlayAll"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/ic_round_playlist_play_24"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:contentDescription="Play all openings" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sectionRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/sectionToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="2dp"
        android:fontFamily="@font/poppins_semi_bold"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingHorizontal="8dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="14sp"
        android:visibility="gone"
        app:drawableEndCompat="@drawable/ic_round_arrow_drop_down_24"
        app:drawableTint="?attr/colorPrimary"
        tools:text="Show all 5 openings"
        tools:visibility="visible" />
</LinearLayout>
