<?xml version="1.0" encoding="utf-8"?>
<!-- one news entry: 16:9 picture slot (video thumbnail, or an icon for posts and articles), title, site and date -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/newsRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="112dp"
        android:layout_height="63dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/newsKindIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_round_article_24" />

        <ImageView
            android:id="@+id/newsThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <!-- kind mark over a picture: play for videos, post or article over the show art -->
        <ImageView
            android:id="@+id/newsPlay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/news_play_bg"
            android:padding="4dp"
            android:src="@drawable/ic_round_play_arrow_24"
            android:visibility="gone"
            app:tint="@android:color/white"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/newsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semi_bold"
            android:lineSpacingExtra="2sp"
            android:maxLines="3"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            tools:text="One Piece TV anime reveals visual and teaser for Egghead arc" />

        <TextView
            android:id="@+id/newsMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            tools:text="YouTube · 3 days ago" />
    </LinearLayout>
</LinearLayout>
