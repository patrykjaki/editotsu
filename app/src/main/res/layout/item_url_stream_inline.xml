<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact single-row card for direct-stream picker rows (STREAM
    presentation only). RELEASE/torrent rows keep using item_url.xml
    unchanged.

    One primary horizontal content row: prominent server name
    (weight 1, single-line, ellipsized so pills/actions can never be
    pushed off-screen), compact pills, then subtitle / download /
    info actions at full 48dp touch targets. An expandable details
    section below preserves the info-button behavior.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    app:cardCornerRadius="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/urlHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="20sp"
                tools:text="VidPlay-1" />

            <LinearLayout
                android:id="@+id/urlPills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical|start" />

            <ImageButton
                android:id="@+id/urlSub"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#00FFFFFF"
                android:src="@drawable/ic_round_subtitles_24"
                android:visibility="gone"
                app:tint="?attr/colorOnBackground"
                tools:ignore="ContentDescription,SpeakableTextPresentCheck"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/urlDownload"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#00FFFFFF"
                android:src="@drawable/ic_download_24"
                android:visibility="gone"
                app:tint="?attr/colorOnBackground"
                tools:ignore="ContentDescription,SpeakableTextPresentCheck"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/urlExpand"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#00FFFFFF"
                android:contentDescription="@string/source_details"
                android:src="@drawable/ic_round_info_24"
                app:tint="?attr/colorOnBackground"
                tools:ignore="ContentDescription,SpeakableTextPresentCheck" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/urlDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/urlDetailsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textSize="13sp"
                android:alpha="0.85" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
