<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    app:cardCornerRadius="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:minHeight="64dp">

        <!--
            Compact content row: the text/metadata column takes the
            available width while the action column (subs / download /
            info) sits at the right side, vertically centered. Actions
            no longer consume a permanent lower band of their own.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!--
                    Header row: release group (large, bold) + small
                    source/tracker cue on the right (when known). No
                    technical pills here; they have their own strip
                    below the title per the follow-ups v1 polish.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/urlHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="20sp"
                        tools:text="SubsPlease" />

                    <ImageView
                        android:id="@+id/urlTrackerCue"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_round_source_24"
                        android:visibility="gone"
                        app:tint="?attr/colorOnBackground"
                        tools:ignore="ContentDescription,SpeakableTextPresentCheck"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Cleaned release title line. -->
                <TextView
                    android:id="@+id/urlReleaseName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    tools:text="Sousou no Frieren - 01v2 (1080p) [AAA94036].mkv" />

                <!--
                    Top chip strip (follow-ups v1): technical pills live on
                    their own full-width row directly under the title,
                    right-aligned MiniMax-style, instead of sharing the
                    seeders/size row. Full width means dense rows wrap far
                    less often; when they genuinely must wrap the strip
                    grows (wrap_content, never clips) without squeezing
                    the header or the seeders line. Same view id, so the
                    bind code is unchanged; pill count stays capped at 4
                    by the summarizer.
                -->
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/urlPills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:flexWrap="wrap"
                    app:alignItems="center"
                    app:justifyContent="flex_end" />

                <!--
                    Hidden field kept for the novel UrlAdapter compatibility.
                    Anime picker writes the release group to urlHeader and does
                    not use this field.
                -->
                <TextView
                    android:id="@+id/urlQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:text="1080p" />

                <!--
                    Seeders are the prominent secondary signal. Size +
                    tracker are muted. Technical pills no longer share
                    this row; they have their own strip above, so this
                    row stays a clean single line.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/urlSeeders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="15sp"
                        android:textColor="?attr/colorPrimary"
                        tools:text="397 seeders" />

                    <TextView
                        android:id="@+id/urlSizeAndTracker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins"
                        android:alpha="0.7"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        tools:text="· 1.48 GB · NyaaSi" />
                </LinearLayout>
            </LinearLayout>

            <!--
                Action column: subs / download / info stay full 48dp touch
                targets, packed at the right side and vertically centered
                against the compact content. urlSub/urlDownload are gone
                unless their flow applies, so a typical torrent row carries
                only the 48dp info action here.
            -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/urlSub"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#00FFFFFF"
                    android:src="@drawable/ic_round_subtitles_24"
                    android:visibility="gone"
                    app:tint="?attr/colorOnBackground"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/urlDownload"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#00FFFFFF"
                    android:src="@drawable/ic_download_24"
                    android:visibility="gone"
                    app:tint="?attr/colorOnBackground"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/urlExpand"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#00FFFFFF"
                    android:contentDescription="@string/source_details"
                    android:src="@drawable/ic_round_info_24"
                    app:tint="?attr/colorOnBackground"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/urlDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/urlDetailsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textSize="13sp"
                android:alpha="0.85" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
