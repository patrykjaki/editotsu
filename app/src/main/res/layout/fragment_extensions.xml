<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Single high-emphasis primary action when extension updates are available -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/updateAllButton"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:minHeight="48dp"
        android:text="@string/extensions_update_all"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.Editotsu.Chip"
        android:visibility="gone"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_round_sync_24"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="18dp"
        app:iconTint="?attr/colorOnPrimary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ani.dantotsu.others.ThemedSwipeRefreshLayout
            android:id="@+id/extensionsSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/allExtensionsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

        </ani.dantotsu.others.ThemedSwipeRefreshLayout>

        <ani.dantotsu.others.SkeletonView
            android:id="@+id/extensionsLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:tag="rows"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/extensionsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/extensionsEmptyIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:alpha="0.5"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_extension"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/extensionsEmptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/extensionsEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/extensionsEmptyAction"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.Editotsu.Chip"
                android:visibility="gone"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
