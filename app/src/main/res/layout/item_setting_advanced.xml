<?xml version="1.0" encoding="utf-8"?>
<!-- The screen's one "Show advanced settings" toggle, after the last section. The chevron turns
     180° when the advanced rows open (RowAdapter.bindAdvanced). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/advancedToggle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/advancedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:importantForAccessibility="no"
        android:textColor="?attr/colorPrimary"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/advancedChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_round_expand_more_24"
        android:tint="?attr/colorPrimary" />
</LinearLayout>
