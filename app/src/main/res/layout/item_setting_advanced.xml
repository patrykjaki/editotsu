<?xml version="1.0" encoding="utf-8"?>
<!-- The screen's one "Show advanced settings" toggle, after the last section. Drawn as a
     one-row card (SettingsCards) so it reads as tappable. The chevron turns 180° when the
     advanced rows open (RowAdapter.bindAdvanced). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/advancedToggle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_round_settings_24"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/advancedText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/poppins_semi_bold"
        android:importantForAccessibility="no"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/advancedChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_round_expand_more_24"
        app:tint="?attr/colorPrimary" />
</LinearLayout>
