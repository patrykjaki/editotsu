<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".settings.ExtensionsActivity">

    <!-- 64dp M3 Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/extensionsBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            android:tooltipText="@string/back"
            app:icon="@drawable/ic_round_arrow_back_ios_new_24"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurface"
            tools:ignore="UnusedAttribute" />

        <TextView
            android:id="@+id/extensions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/extensions"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            tools:ignore="UnusedAttribute" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/extensionsReposButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/extensions_menu_repositories"
            android:tooltipText="@string/extensions_menu_repositories"
            app:icon="@drawable/ic_round_source_24"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:ignore="UnusedAttribute" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/extensionsMenuButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/extensions_more_options"
            android:tooltipText="@string/extensions_more_options"
            app:icon="@drawable/ic_round_dots_vertical_24"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:ignore="UnusedAttribute" />
    </LinearLayout>

    <!-- M3 Primary Tabs: Anime / Manga / Novel -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/extensionsTypeTabs"
        style="@style/Widget.Material3.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/colorSurface"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:tabGravity="fill"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabPaddingEnd="12dp"
        app:tabPaddingStart="12dp"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextAppearance="@style/TextAppearance.Editotsu.Tab"
        app:tabTextColor="?attr/colorOnSurfaceVariant" />

    <View
        android:id="@+id/extensionsTabsDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- Search pill on top + Installed / Available segmented control + optional Language filter -->
    <LinearLayout
        android:id="@+id/extensionsFilterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchBar"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:transitionName="@string/search"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_round_search_24"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <AutoCompleteTextView
                    android:id="@+id/searchViewText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/poppins_family"
                    android:hint="@string/extensions_search_anime"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="16sp"
                    tools:ignore="LabelFor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/searchClear"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/clear"
                    android:tooltipText="@string/clear"
                    android:visibility="gone"
                    app:icon="@drawable/ic_round_close_24"
                    app:iconSize="24dp"
                    app:iconTint="?attr/colorOnSurfaceVariant"
                    tools:ignore="UnusedAttribute" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/extensionsStatusToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/extensionsStatusInstalled"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/extensions_filter_installed"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.Editotsu.Chip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/extensionsStatusAvailable"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/extensions_filter_available"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.Editotsu.Chip" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:id="@+id/extensionsLanguageBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.chip.Chip
                android:id="@+id/extensionsLanguageChip"
                style="@style/Widget.Editotsu.Chip.Dropdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/extensions_language_all" />
        </LinearLayout>
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:id="@+id/fragmentExtensionsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>
