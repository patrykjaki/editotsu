<?xml version="1.0" encoding="utf-8"?>
<!-- Chromecast (play-services-cast) and reader OCR (ML Kit) are in the google build only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- On-demand ML Kit OCR model downloads. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,ocr_japanese" />

        <service
            android:name="ani.dantotsu.media.anime.cast.CastProxyServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name="ani.dantotsu.media.anime.cast.CastExpandedControllerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="ani.dantotsu.media.anime.cast.DantotsuCastOptionsProvider" />
    </application>

</manifest>
